# Copy to .env and edit. NEVER commit the real .env.
# The defaults below need NO API key: a small model runs on your own machine.

# ============ Provider selection ============
# LLM_PROVIDER: local | ollama | huggingface | gemini | github | openai | groq
# EMBED_PROVIDER: huggingface | openai
LLM_PROVIDER=local
EMBED_PROVIDER=huggingface

# Skip the grade/rewrite self-correction loop for faster answers (1 = fast).
AGENT_FAST=0

# ============ Local model  (LLM_PROVIDER=local, the default) ============
# Runs on-device via transformers. Use Qwen/Qwen2.5-0.5B-Instruct for a lighter,
# faster (lower quality) model.
LOCAL_CHAT_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LOCAL_MAX_NEW_TOKENS=220

# ============ Ollama  (LLM_PROVIDER=ollama) ============
# Fast quantized local models; needs the Ollama app running. Local dev only.
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434

# ============ Hugging Face Inference API  (LLM_PROVIDER=huggingface) ============
# Needs a token with the "Inference Providers" permission:
# https://huggingface.co/settings/tokens
HF_TOKEN=
HF_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ============ Embeddings ============
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============ Other hosted providers (some are blocked in some regions) ============
# gemini and groq also need:  pip install -r requirements-optional.txt
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GITHUB_TOKEN=
GITHUB_CHAT_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# ============ OpenAI  (set LLM_PROVIDER / EMBED_PROVIDER to 'openai') ============
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
