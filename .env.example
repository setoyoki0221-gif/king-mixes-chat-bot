# Copy to .env and edit. NEVER commit the real .env.
# The defaults below need NO API key: a small model runs on your own machine.

# ============ Provider selection ============
# LLM_PROVIDER: local | ollama | huggingface | gemini | github | openai | groq
# EMBED_PROVIDER: huggingface | openai
LLM_PROVIDER=local
EMBED_PROVIDER=huggingface

# Skip the grade/rewrite self-correction loop for faster answers (1 = fast).
AGENT_FAST=0

# ============ Local model  (LLM_PROVIDER=local, the default) ============
# Runs on-device via transformers. Use Qwen/Qwen2.5-0.5B-Instruct for a lighter,
# faster (lower quality) model.
LOCAL_CHAT_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LOCAL_MAX_NEW_TOKENS=220
